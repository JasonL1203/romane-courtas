---
import { parcours } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const initiales = (n: string) => n.split(/[\s+]+/).filter(Boolean).slice(0, 2).map((m) => m[0]).join('').toUpperCase();
---
<section class="tl" id="parcours" data-theme-light>
  <div class="wrap">
    <div class="tl__head">
      <h2 class="tl__title">
        <span class="line-mask"><span data-reveal>Parcours</span></span>
      </h2>
    </div>
    <ol class="tl__list">
      {parcours.map((e, i) => (
        <li class="tl__row" data-row data-float-row={i}>
          <span class="tl__line" data-row-line></span>
          <span class="tl__period">{e.periode}</span>
          <h3 class="tl__org">{e.structure}</h3>
          <div class="tl__desc">
            <strong>{e.poste}</strong>
            <p>{e.texte}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="tl__float" data-float aria-hidden="true">
      {parcours.map((e, i) => (
        <div class="tl__float-item" data-float-item={i}>
          {e.image
            ? <img src={`${base}${e.image}`} alt="" loading="lazy" />
            : <div class="tl__float-ph"><span>{initiales(e.structure)}</span><small>Image à venir</small></div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tl { background: var(--paper); color: var(--ink); padding-block: clamp(80px, 14vh, 180px); border-radius: 28px; margin-inline: clamp(6px, 1vw, 14px); }
  .tl .eyebrow { color: #5d5a54; }
  .tl__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(40px, 8vh, 96px); }
  .tl__title { margin: 0; font-family: var(--f-display); font-weight: 700; font-size: clamp(52px, 8vw, 140px); line-height: 1; letter-spacing: -.03em; }
  .tl__list { list-style: none; margin: 0; padding: 0; }
  .tl__row {
    position: relative; display: grid; grid-template-columns: 180px 1.2fr 1fr; gap: 24px; align-items: baseline;
    padding: 34px 0; transition: padding .5s var(--ease);
  }
  .tl__row:last-child { border-bottom: 1px solid rgba(13,13,12,.18); }
  .tl__line { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: rgba(13,13,12,.18); transform-origin: left; }
  .tl__period { font-size: 14px; font-weight: 500; letter-spacing: .02em; color: #55524c; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tl__org { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: clamp(30px, 4vw, 64px); line-height: 1; letter-spacing: -.035em; transition: translate .5s var(--ease), rotate .5s var(--ease), color .3s; }
  .tl__desc strong { font-weight: 600; display: block; margin-bottom: 6px; }
  .tl__desc p { margin: 0; color: #55524c; font-size: 15px; }
  .tl__row:hover .tl__org { translate: 14px 0; color: var(--accent); }
  .tl__float {
    position: fixed; top: 0; left: 0; z-index: 40; pointer-events: none;
    width: clamp(220px, 22vw, 340px); aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden;
    opacity: 0; visibility: hidden; box-shadow: 0 30px 60px -20px rgba(13,13,12,.45);
  }
  .tl__float-item { position: absolute; inset: 0; opacity: 0; transition: opacity .35s; }
  .tl__float-item.is-on { opacity: 1; }
  .tl__float-item img { width: 100%; height: 100%; object-fit: cover; }
  .tl__float-ph { width: 100%; height: 100%; display: grid; place-content: center; justify-items: center; gap: 8px; background: var(--accent); color: var(--on-accent); }
  .tl__float-ph span { font-family: var(--f-display); font-weight: 900; font-stretch: 125%; font-size: clamp(56px, 6vw, 96px); line-height: 1; letter-spacing: -.03em; }
  .tl__float-ph small { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  @media (hover: none), (pointer: coarse) { .tl__float { display: none; } }
  @media (max-width: 900px) {
    .tl__row { grid-template-columns: 1fr; gap: 10px; padding: 28px 0; align-items: start; }
    .tl__float { display: none; }
  }
</style>
