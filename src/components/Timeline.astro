---
import { parcours } from '../data/site';
---
<section class="tl" id="parcours" data-theme-light>
  <div class="wrap">
    <div class="tl__head">
      <h2 class="tl__title">
        <span class="line-mask"><span data-reveal>Parcours</span></span>
      </h2>
    </div>
    <ol class="tl__list">
      {parcours.map((e, i) => (
        <li class="tl__row" data-row>
          <span class="tl__line" data-row-line></span>
          <span class="tl__period">{e.periode}</span>
          <h3 class="tl__org">{e.structure}</h3>
          <div class="tl__desc">
            <strong>{e.poste}</strong>
            <p>{e.texte}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tl { background: var(--paper); color: var(--ink); padding-block: clamp(80px, 14vh, 180px); border-radius: 28px; margin-inline: clamp(6px, 1vw, 14px); box-shadow: 0 0 140px -30px rgba(47, 84, 255, .45), 0 50px 90px -50px rgba(0, 0, 0, .9); }
  .tl .eyebrow { color: #5d5a54; }
  .tl__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(40px, 8vh, 96px); }
  .tl__title { margin: 0; font-family: var(--f-display); font-weight: 700; font-size: clamp(52px, 8vw, 140px); line-height: 1; letter-spacing: -.03em; }
  .tl__list { list-style: none; margin: 0; padding: 0; }
  .tl__row {
    position: relative; display: grid; grid-template-columns: 180px 1.2fr 1fr; gap: 24px; align-items: baseline;
    padding: 34px 0; transition: opacity .45s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) { .tl__list:hover .tl__row:not(:hover) { opacity: .32; } }
  .tl__row:last-child { border-bottom: 1px solid rgba(13,13,12,.18); }
  .tl__line { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: rgba(13,13,12,.18); transform-origin: left; }
  .tl__period { font-size: 14px; font-weight: 500; letter-spacing: .02em; color: #55524c; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tl__org { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: clamp(30px, 4vw, 64px); line-height: 1; letter-spacing: -.035em; transition: translate .5s var(--ease), rotate .5s var(--ease), color .3s; }
  .tl__desc strong { font-weight: 600; display: block; margin-bottom: 6px; }
  .tl__desc p { margin: 0; color: #55524c; font-size: 15px; }
  .tl__row:hover .tl__org { translate: 14px 0; color: var(--accent); }
  @media (max-width: 900px) {
    .tl { padding-block: clamp(44px, 7vh, 80px); border-radius: 22px; }
    .tl__head { margin-bottom: clamp(28px, 5vh, 56px); }
    .tl__row { grid-template-columns: 1fr; gap: 10px; padding: 28px 0; align-items: start; }
    }
</style>
