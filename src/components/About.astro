---
import { profil } from '../data/site';
---
<section class="about wrap" id="profil">
  <div class="about__head">
    <div class="about__photo">
      <div class="about__photo-inner">
        <span class="about__initial serif">{profil.prenom[0]}</span>
      </div>
      <span class="placeholder-tag">Portrait à venir</span>
    </div>
  </div>

  <div class="about__body">
    <p class="about__statement" data-words>
      {profil.bio[0]} <span class="accent">{profil.bio[1]}</span>
    </p>

    <div class="about__skills">
      <ul>
        {profil.competences.map((s) => <li data-skill>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(220px, 1fr) 2.2fr; gap: clamp(32px, 6vw, 96px); padding-block: clamp(56px, 10vh, 120px) 0; }
  .about__head { display: flex; flex-direction: column; gap: 28px; align-self: start; }
  .about__photo {
    position: relative; aspect-ratio: 3 / 4; border-radius: 18px; overflow: hidden; max-width: 340px;
    box-shadow: 0 60px 110px -45px rgba(47, 84, 255, .55), 0 34px 60px -30px rgba(0, 0, 0, .9);
  }
  .about__photo::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .09) inset, 0 1px 0 0 rgba(255, 255, 255, .22) inset;
    background: linear-gradient(140deg, rgba(255, 255, 255, .10) 0%, transparent 32%);
  }
  .about__photo-inner {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: radial-gradient(120% 80% at 30% 20%, #27306a 0%, #151936 55%, #0b0c14 100%);
  }
  .about__initial { font-size: clamp(140px, 18vw, 260px); color: var(--accent); line-height: 1; text-shadow: 0 18px 50px rgba(47, 84, 255, .55); }
  .about__statement {
    margin: 0;
    font-family: var(--f-display); font-weight: 500;
    font-size: clamp(26px, 3.6vw, 56px); line-height: 1.08; letter-spacing: -.025em;
  }
  .about__statement .serif { font-size: 1.06em; }
  .about__stats { list-style: none; padding: 0; margin: clamp(48px, 8vh, 96px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .about__stats li { padding: 22px 16px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .about__stats li + li { padding-left: 16px; border-left: 1px solid var(--line); }
  .about__num { font-family: var(--f-display); font-weight: 700; font-size: clamp(44px, 6vw, 92px); line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .about__lbl { color: var(--muted); font-size: 14px; }
  .about__skills { margin-top: clamp(48px, 8vh, 96px); display: flex; flex-direction: column; gap: 18px; }
  .about__skills ul { list-style: none; padding: 28px 0 0; margin: 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 10px 0; }
  .about__skills li { font-size: clamp(17px, 1.5vw, 21px); line-height: 1.3; white-space: nowrap; }
  .about__skills li:not(:last-child)::after { content: '/'; color: var(--accent); margin-inline: .7em; }
  @media (max-width: 1100px) { .about { grid-template-columns: minmax(200px, 1fr) 2fr; gap: clamp(24px, 4vw, 48px); } }
  @media (max-width: 720px) {
    .about { grid-template-columns: 1fr; }
    .about__photo { max-width: 260px; }
    .about__stats { grid-template-columns: 1fr 1fr 1fr; }
    .about__stats li + li { padding-left: 12px; }
  }
</style>
