---
import { pages, url } from '../data/pages';
---
<section class="menu wrap" id="explorer" aria-label="Pages du portfolio">
  <ul class="menu__list">
    {pages.map((p, i) => (
      <li data-row>
        <span class="menu__line" data-row-line></span>
        <a class="menu__link" href={url(p.slug)} data-page data-label={p.label} data-cursor="Ouvrir">
          <span class="menu__label">{p.label}</span>
          <span class="menu__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .menu { padding-block: clamp(40px, 8vh, 100px) clamp(60px, 10vh, 120px); }
  .menu .eyebrow { margin-bottom: 28px; }
  .menu__list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .menu__list li { position: relative; }
  .menu__line { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--line); transform-origin: left; }
  .menu__link {
    position: relative; display: grid; grid-template-columns: 1fr 60px; align-items: center; gap: 24px;
    padding: clamp(18px, 3vh, 34px) 0; overflow: hidden; isolation: isolate;
  }
  .menu__link::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent);
    transform: scaleY(0); transform-origin: bottom; transition: transform .6s var(--ease);
  }
  .menu__link:hover::before, .menu__link:focus-visible::before { transform: scaleY(1); }
  .menu__link:hover { color: var(--on-accent); }
  .menu__num { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; padding-left: 8px; transition: color .3s; }
  .menu__label { font-family: var(--f-display); font-weight: 700; font-size: clamp(48px, 8vw, 132px); line-height: .9; letter-spacing: -.045em; transition: translate .6s var(--ease); }
  .menu__link:hover .menu__label { translate: 20px 0; font-family: var(--f-serif); font-style: italic; font-weight: 400; letter-spacing: -.01em; }
  .menu__resume { color: var(--muted); font-size: 15px; transition: color .3s; }
  .menu__arrow { font-size: 32px; justify-self: end; padding-right: 8px; transition: translate .6s var(--ease), rotate .6s var(--ease); }
  .menu__link:hover .menu__num, .menu__link:hover .menu__resume { color: var(--ink); }
  .menu__link:hover .menu__arrow { translate: -8px 0; rotate: -45deg; }
  @media (max-width: 720px) {
    .menu__link { grid-template-columns: 1fr 30px; gap: 12px; }
    .menu__resume { display: none; }
    .menu__arrow { font-size: 22px; }
  }
</style>
