---
import { projets } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const embedUrl = (v?: { plateforme: 'youtube' | 'vimeo'; id: string }) =>
  !v ? '' : v.plateforme === 'vimeo'
    ? `https://player.vimeo.com/video/${v.id}`
    : `https://www.youtube-nocookie.com/embed/${v.id}?rel=0`;
---
<section class="projects" id="projets">
  <div class="projects__intro wrap">
    <div>
      <h2 class="projects__title">
        <span class="line-mask"><span data-reveal>Projets</span></span>
      </h2>
    </div>
  </div>

  <div class="carousel" data-carousel>
    <ul class="projects__track" data-carousel-track>
      {[0, 1].map((copie) =>
        projets.map((p, i) => (
          <li class="card" data-card aria-hidden={copie ? 'true' : undefined} style={`--c1:${p.teinte[0]};--c2:${p.teinte[1]}`}>
            <button class="card__btn" data-open={p.slug} data-cursor="Voir" tabindex={copie ? -1 : undefined} aria-label={`Ouvrir le projet ${p.titre}`}>
              <div class="card__media">
                <div class="card__img" style={p.image ? `background-image:url(${base}${p.image})` : `--c1:${p.teinte[0]};--c2:${p.teinte[1]}`}>
                  {!p.image && <span class="card__big serif">{p.titre.split(' ')[0]}</span>}
                </div>
                {!p.image && <span class="placeholder-tag">Visuel à venir</span>}
                <span class="card__glare"></span>
              </div>
              <div class="card__info">
                <h3 class="card__title">{p.titre}</h3>
                <span class="card__cat">{p.categorie} · {p.annee}</span>
              </div>
            </button>
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<div class="modal" data-modal aria-hidden="true">
  <div class="modal__veil" data-close></div>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Détail du projet" data-lenis-prevent>
    <div class="modal__flash" data-flash aria-hidden="true"></div>
    {projets.map((p, i) => (
      <article class="modal__item" data-project={p.slug} hidden>
        <header class="modal__head">
          <h3 class="modal__title">{p.titre}</h3>
          <dl class="modal__meta">
            <div><dt>Rôle</dt><dd>{p.role}</dd></div>
            <div><dt>Année</dt><dd>{p.annee}</dd></div>
            <div><dt>Catégorie</dt><dd>{p.categorie}</dd></div>
          </dl>
        </header>
        <div class="modal__video">
          {p.video ? (
            <iframe data-src={embedUrl(p.video)} title={p.titre} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          ) : (
            <div class="modal__video-ph" style={`--c1:${p.teinte[0]};--c2:${p.teinte[1]}`}>
              <span class="modal__play">▶</span>
              <span class="placeholder-tag">Vidéo à venir</span>
            </div>
          )}
        </div>
        <div class="modal__text">
          <p class="modal__lead">{p.resume}</p>
          {p.description.map((d) => <p>{d}</p>)}
        </div>
        <div class="modal__end" aria-hidden="true">
          <span class="modal__end-arrow">↓</span>
          <span class="modal__end-title">Revenir aux projets</span>
          <span class="modal__end-bar"><i data-pull-bar></i></span>
        </div>
      </article>
    ))}
  </div>
  <button class="modal__close" data-close aria-label="Fermer"><span aria-hidden="true">✕</span></button>
</div>

<style>
  .projects { padding-block: clamp(30px, 6vh, 80px) clamp(40px, 8vh, 90px); overflow: hidden; transform-origin: 50% 30%; }
  .projects__intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(20px, 4vh, 48px); }
  .projects__intro .eyebrow { margin-bottom: 20px; }
  .projects__title { margin: 0; font-family: var(--f-display); font-weight: 700; font-size: clamp(52px, 8vw, 140px); line-height: 1; letter-spacing: -.03em; }
  .projects__hint { margin: 0; color: var(--muted); font-size: 14px; max-width: 30ch; text-align: right; }

  .carousel { position: relative; touch-action: pan-y; user-select: none; -webkit-user-select: none; perspective: 1500px; padding-block: 30px 70px; }
  
  .projects__track { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(16px, 2.4vw, 36px); width: max-content; will-change: transform; transform-style: preserve-3d; }
  .carousel__edge { position: absolute; top: 0; bottom: 0; width: 12vw; pointer-events: none; display: flex; align-items: center; opacity: .0; transition: opacity .4s; color: var(--fg); font-size: 28px; }
  .carousel__edge--l { left: 0; justify-content: flex-start; padding-left: var(--gutter); background: linear-gradient(90deg, var(--bg), transparent); }
  .carousel__edge--r { right: 0; justify-content: flex-end; padding-right: var(--gutter); background: linear-gradient(-90deg, var(--bg), transparent); }
  .carousel.go-left .carousel__edge--l, .carousel.go-right .carousel__edge--r { opacity: 1; }

  /* la piste ne capte pas les clics : en 3D son plan passe devant les cartes qui reculent */
  .projects__track { pointer-events: none; }
  .card { pointer-events: auto; }
  .card { flex: 0 0 auto; width: clamp(230px, 22.5vw, 360px); transform-style: preserve-3d; will-change: transform; }
  .card__btn { display: block; width: 100%; text-align: left; cursor: pointer; transform-style: preserve-3d; }
  .card__media {
    position: relative; aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateZ(var(--lift, 0px));
    transition: transform .5s var(--ease), box-shadow .5s var(--ease);
    box-shadow: 0 40px 70px -34px rgba(0, 0, 0, .95), 0 26px 80px -40px color-mix(in srgb, var(--c1) 55%, transparent);
  }
  .card__media::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .10) inset, 0 1px 0 0 rgba(255, 255, 255, .28) inset;
    background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, .35) 100%);
  }
  .card__glare {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .4s;
    background: radial-gradient(60% 50% at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, .34), transparent 70%);
    mix-blend-mode: soft-light;
  }
  .card__btn:hover .card__media, .card__btn:focus-visible .card__media {
    --lift: 46px;
    box-shadow: 0 60px 90px -36px rgba(0, 0, 0, 1), 0 40px 110px -34px color-mix(in srgb, var(--c1) 80%, transparent);
  }
  .card__btn:hover .card__glare { opacity: 1; }
  @media (hover: none), (pointer: coarse) {
    .card__btn:hover .card__media { --lift: 0px; }
    .card__btn:hover .card__glare { opacity: 0; }
  }
  .card__btn.is-tilting .card__media { transition: transform .12s linear, box-shadow .5s var(--ease); }
  .card__img {
    position: absolute; inset: 0; background-size: cover; background-position: center;
    background-image: radial-gradient(120% 90% at 20% 15%, var(--c1) 0%, var(--c2) 70%);
    display: grid; place-items: center;
    transform: scale(1.08); transition: transform 1.1s var(--ease);
  }
  .card__img, .card__img * { pointer-events: none; }
  .card__big { font-size: clamp(38px, 4vw, 72px); color: rgba(255,255,255,.88); mix-blend-mode: overlay; line-height: 1; text-align: center; padding: 0 12px; }
  .card__btn:hover .card__img, .card__btn:focus-visible .card__img { transform: scale(1); }
  .card__info { display: grid; grid-template-columns: 1fr; row-gap: 2px; align-items: baseline; padding-top: 22px; }
  .card__num { color: var(--accent); font-size: 13px; font-variant-numeric: tabular-nums; }
  .card__title { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: clamp(20px, 2vw, 30px); letter-spacing: -.02em; }
  .card__cat { color: var(--muted); font-size: 14px; }
  @media (hover: none), (pointer: coarse) { .card__btn { cursor: pointer; } .carousel__edge { display: none; } }
  @media (max-width: 900px) {
    .projects__hint { text-align: left; }
    .card { width: 68vw; }
  }

  /* modale */
  .modal { position: fixed; inset: 0; z-index: 120; visibility: hidden; }
  .modal.is-open { visibility: visible; }
  .modal__veil { position: absolute; inset: 0; background: rgba(0,0,0,.7); opacity: 0; }
  .modal__panel {
    position: absolute; inset: 0;
    background: var(--paper); color: var(--ink);
    overflow-y: auto; overscroll-behavior: contain;
    padding: clamp(24px, 5vw, 72px) var(--gutter) 0;
    transform: translateY(100%);
  }
  .modal__flash { position: fixed; inset: 0; z-index: 2; pointer-events: none; opacity: 0; background: radial-gradient(120% 90% at 20% 15%, var(--c1, #2f54ff) 0%, var(--c2, #0d0d0c) 70%); }
  .modal__close {
    position: fixed; z-index: 3; top: 18px; right: var(--gutter);
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--paper); font-size: 20px; line-height: 1; cursor: pointer;
    box-shadow: 0 16px 34px -12px rgba(13, 13, 12, .6);
    opacity: 0; transition: rotate .4s var(--ease), background .3s, color .3s;
  }
  .modal__close:hover { background: var(--accent); color: var(--on-accent); rotate: 90deg; }
  .modal__end {
    margin: clamp(56px, 9vh, 110px) calc(-1 * var(--gutter)) 0; padding: 26px var(--gutter) 30px;
    min-height: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 16px;
    background: var(--bg); color: var(--fg); border-radius: 28px 28px 0 0;
  }
  .modal__end-arrow { font-size: 22px; line-height: 1; animation: endnudge 1.4s var(--ease) infinite; }
  @keyframes endnudge { 0%,100% { translate: 0 0; } 50% { translate: 0 10px; } }
  .modal__end-title { font-family: var(--f-display); font-weight: 600; font-size: clamp(26px, 3.2vw, 48px); line-height: 1; letter-spacing: -.03em; }
  .modal__end-bar { display: block; flex-basis: 100%; height: 2px; background: var(--line); }
  .modal__end-bar i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .modal__panel .eyebrow { color: #5d5a54; }
  .modal__title { margin: 16px 0 28px; font-family: var(--f-display); font-weight: 700; font-size: clamp(44px, 8vw, 132px); line-height: .98; letter-spacing: -.03em; overflow-wrap: break-word; hyphens: auto; padding-right: 64px; }
  .modal__meta { display: flex; flex-wrap: wrap; gap: 12px 48px; margin: 0 0 40px; padding-top: 18px; border-top: 1px solid rgba(13,13,12,.15); }
  .modal__meta dt { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; color: #6b6861; }
  .modal__meta dd { margin: 4px 0 0; font-weight: 500; }
  .modal__video { aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; background: #000; box-shadow: 0 60px 100px -50px rgba(13, 13, 12, .75), 0 30px 50px -30px rgba(13, 13, 12, .5); }
  .modal__video iframe { width: 100%; height: 100%; border: 0; }
  .modal__video-ph { position: relative; width: 100%; height: 100%; display: grid; place-items: center; background: radial-gradient(120% 120% at 20% 10%, var(--c1), var(--c2) 70%); }
  .modal__play { width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center; box-shadow: 0 24px 50px -14px rgba(0, 0, 0, .6); background: rgba(255,255,255,.92); color: var(--ink); font-size: 24px; padding-left: 5px; }
  .modal__text { max-width: 720px; margin-top: 40px; font-size: 18px; }
  .modal__next { display: flex; flex-direction: column; gap: 14px; width: 100%; margin-top: clamp(64px, 12vh, 140px); padding-top: 32px; border-top: 1px solid rgba(13,13,12,.15); text-align: left; cursor: pointer; }
  .modal__next-title { font-family: var(--f-display); font-weight: 700; font-size: clamp(40px, 7vw, 110px); line-height: .9; letter-spacing: -.045em; transition: color .3s, transform .5s var(--ease); }
  .modal__next:hover .modal__next-title { color: var(--accent); transform: translateX(12px); }
  .modal__lead { font-family: var(--f-display); font-size: clamp(22px, 2.4vw, 32px); line-height: 1.2; letter-spacing: -.015em; font-weight: 500; }
</style>
