---
import { profil } from '../data/site';
import { pages, url } from '../data/pages';
interface Props { actif?: string }
const { actif = '' } = Astro.props;
---
<header class="header" data-header>
  <a href={url('')} class="header__logo" data-page data-label={profil.prenom}>{profil.prenom}<span class="accent">.</span></a>
  <nav class="header__nav" aria-label="Navigation principale">
    {pages.map((p) => (
      <a href={url(p.slug)} data-page data-label={p.label} aria-current={actif === p.slug ? 'page' : undefined}>
        {p.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px var(--gutter);
    color: #fff;
    transition: transform .6s var(--ease);
  }
  /* barre en verre dépoli, visible dès qu'on défile */
  .header::before {
    content: ''; position: absolute; z-index: -1; inset: 8px calc(var(--gutter) - 18px);
    border-radius: 16px; background: rgba(16, 17, 24, .58);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .08) inset, 0 18px 40px -18px rgba(0, 0, 0, .7);
    opacity: 0; transition: opacity .45s var(--ease);
  }
  .header.is-scrolled::before { opacity: 1; -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4); }
  .header.is-hidden { transform: translateY(-110%); }
  .header__logo { font-family: var(--f-display); font-weight: 700; font-size: 22px; letter-spacing: -.02em; }
  .header__logo .accent { color: #fff; }
  .header__nav { display: flex; gap: clamp(14px, 2.4vw, 36px); font-size: 14px; }
  .header__nav a { display: block; position: relative; line-height: 1.4em; opacity: .7; }
  .header__nav a:hover, .header__nav a[aria-current='page'] { opacity: 1; }
  .header__nav a[aria-current='page']::before { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: #fff; }
  .header__status { font-size: 13px; display: inline-flex; align-items: center; gap: 8px; }
  .header__status i { width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: pulse 1.8s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .25 } }
  @media (max-width: 720px) {
    .header__status { display: none; }
    .header__nav { gap: 14px; font-size: 13px; }
    .header::before { inset: 6px 6px; }
  }
  @media (max-width: 400px) {
    .header { padding-inline: 14px; gap: 10px; }
    .header__logo { font-size: 18px; }
    .header__nav { gap: 10px; font-size: 12px; }
  }
</style>
